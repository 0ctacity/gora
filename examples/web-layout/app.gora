gora: 1
kind: app
name: Web Layout Parity
imports:
  components:
    feature: components/feature-card.gora
  tokens:
    theme: theme.gora
viewport: { width: 1280, height: 900, background: "#F4F6FB" }
breakpoints:
  narrow: { max_width: 699 }
  medium: { min_width: 700, max_width: 999 }
  wide: { min_width: 1000 }
entry: home
screens:
  home:
    type: scroll
    name: web-layout-scroll
    props: { axis: vertical, scrollbar: true }
    children:
      - type: stack
        name: page
        props:
          direction: vertical
          height: 1180
          gap: 40
          padding: { top: 28, right: 48, bottom: 56, left: 48 }
        responsive:
          narrow:
            props:
              height: 1880
              gap: 28
              padding: { top: 20, right: 20, bottom: 40, left: 20 }
          medium:
            props:
              height: 1420
              padding: { top: 24, right: 32, bottom: 48, left: 32 }
        children:
          - type: stack
            name: navigation
            props: { direction: horizontal, min_height: 48, alignment: center, column_gap: 24, row_gap: 12, wrap: true }
            children:
              - type: stack
                props: { direction: horizontal, gap: 10, alignment: center }
                children:
                  - type: surface
                    props: { width: 34, height: 34, background: { ref: theme.color.primary }, radius: 10 }
                    children:
                      - type: text
                        props: { text: G, size: 16, weight: 700, color: "#FFFFFF", font: ../dashboard/assets/StudioSans.ttf }
                        place: { alignment: center }
                  - type: text
                    props: { text: GORA, size: 15, weight: 700, letter_spacing: 1.4, color: { ref: theme.color.ink }, font: ../dashboard/assets/StudioSans.ttf }
              - type: spacer
                place: { grow: 1, basis: 24 }
              - type: stack
                props: { direction: horizontal, gap: 24, alignment: center, wrap: true }
                responsive:
                  narrow: { visible: false }
                children:
                  - type: text
                    props: { text: Product, size: 13, weight: 600, color: { ref: theme.color.ink }, font: ../dashboard/assets/StudioSans.ttf }
                  - type: text
                    props: { text: Principles, size: 13, weight: 600, color: { ref: theme.color.ink }, font: ../dashboard/assets/StudioSans.ttf }
                  - type: text
                    props: { text: Changelog, size: 13, weight: 600, color: { ref: theme.color.ink }, font: ../dashboard/assets/StudioSans.ttf }
              - type: surface
                props: { width: 124, height: 40, background: { ref: theme.color.ink }, radius: 10 }
                place: { alignment: center }
                children:
                  - type: text
                    props: { text: Open Studio, size: 12, weight: 600, color: "#FFFFFF", font: ../dashboard/assets/StudioSans.ttf }
                    place: { alignment: center }
          - type: surface
            name: percentage-hero
            props:
              width: { percent: 100 }
              aspect_ratio: { width: 16, height: 5 }
              background: { ref: theme.linear_gradient.hero }
              radius: 24
              clip: true
            responsive:
              narrow:
                props:
                  aspect_ratio: { width: 4, height: 5 }
              medium:
                props: { aspect_ratio: { width: 2, height: 1 } }
            children:
              - type: overlay
                children:
                  - type: image
                    props: { src: ../dashboard/assets/dashboard.jpg, width: { percent: 100 }, height: { percent: 100 }, fit: cover, opacity: 0.16 }
                  - type: stack
                    props: { direction: vertical, gap: 14, width: { percent: 58 }, alignment: start }
                    place: { x: 40, y: 36 }
                    responsive:
                      narrow:
                        props: { width: { percent: 88 } }
                        place: { x: 24, y: 28 }
                    children:
                      - type: text
                        props: { text: WEB LAYOUT, size: 11, weight: 700, letter_spacing: 1.6, color: "#B9B7FF", font: ../dashboard/assets/StudioSans.ttf }
                      - type: text
                        props: { text: Responsive by construction., size: 36, weight: 700, line_height: 42, wrap: true, color: "#FFFFFF", font: ../dashboard/assets/StudioSans.ttf }
                      - type: text
                        props: { text: "Percentages, intrinsic measurement, ratios, wrapping, growth, and shrink now resolve through one deterministic geometry model.", size: 14, line_height: 21, wrap: true, color: "#E5E4FF", font: ../dashboard/assets/StudioSans.ttf }
          - type: stack
            props: { direction: vertical, gap: 10, alignment: start }
            children:
              - type: text
                props: { text: A web-shaped layout vocabulary, size: 28, weight: 700, color: { ref: theme.color.ink }, font: ../dashboard/assets/StudioSans.ttf }
              - type: text
                props: { text: Resize Studio to watch percentage bases pack into deterministic lines., size: 14, color: { ref: theme.color.muted }, font: ../dashboard/assets/StudioSans.ttf }
          - type: stack
            name: wrapping-card-deck
            props: { direction: horizontal, wrap: true, column_gap: 22, row_gap: 28, alignment: stretch }
            children:
              - type: instance
                props: { component: feature, parameters: { eyebrow: MEASURE, title: Recursive intrinsic sizing, description: Nested surfaces and stacks report preferred geometry before their parent allocates space. } }
                responsive:
                  narrow: { place: { basis: { percent: 100 } } }
                  medium: { place: { basis: { percent: 46 } } }
              - type: instance
                props: { component: feature, parameters: { eyebrow: ALLOCATE, title: Grow and shrink deliberately, description: Basis establishes intent while explicit weights distribute positive space and constrained deficits. } }
                responsive:
                  narrow: { place: { basis: { percent: 100 } } }
                  medium: { place: { basis: { percent: 46 } } }
              - type: instance
                props: { component: feature, parameters: { eyebrow: PLACE, title: Per-child alignment, description: Each item can override the line alignment without changing source order or inspection identity. } }
                place: { alignment: end }
                responsive:
                  narrow: { place: { basis: { percent: 100 }, alignment: stretch } }
                  medium: { place: { basis: { percent: 46 } } }
          - type: stack
            props: { direction: horizontal, gap: 20, alignment: center }
            children:
              - type: surface
                props: { width: { ref: theme.dimension.half }, height: 2, background: { ref: theme.color.primary } }
              - type: text
                props: { text: "50% token", size: 11, weight: 700, color: { ref: theme.color.primary }, font: ../dashboard/assets/StudioSans.ttf }
