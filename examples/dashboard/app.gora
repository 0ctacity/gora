gora: 1
kind: app
name: Northstar Analytics
imports:
  components:
    metric: components/metric.gora
    sidebar: components/sidebar.gora
  tokens:
    theme: theme.gora
viewport: { width: 1280, height: 800, background: "#F4F6FA" }
breakpoints:
  compact: { max_width: 759 }
  wide: { min_width: 760 }
entry: overview
screens:
  overview:
    type: stack
    name: overview-shell
    props: { direction: horizontal, gap: 0 }
    children:
      - type: instance
        name: overview-sidebar
        props: { component: sidebar }
        responsive:
          compact: { visible: false }
      - type: scroll
        name: overview-feed
        props: { axis: vertical, scrollbar: true }
        place: { basis: 0, grow: 1, shrink: 1 }
        children:
          - type: stack
            props:
              direction: vertical
              gap: 20
              height: 940
              padding: { top: 28, right: 28, bottom: 28, left: 28 }
            responsive:
              compact:
                props: { height: 1510, padding: { top: 22, right: 20, bottom: 22, left: 20 } }
            children:
              - type: stack
                props: { direction: horizontal, gap: 16, height: 66, alignment: center }
                children:
                  - type: stack
                    props: { direction: vertical, gap: 4 }
                    children:
                      - type: text
                        props: { text: "Thursday, 30 July", size: 11, weight: 600, color: "#8A94A6", font: assets/StudioSans.ttf }
                      - type: text
                        props: { text: "Good morning, Ada", size: 28, weight: 700, color: "#182230", font: assets/StudioSans.ttf }
                  - type: spacer
                    place: { grow: 1 }
                  - type: button
                    name: export-overview
                    props: { label: Export overview, width: 148, height: 42, background: "#635BFF", radius: 10, padding: { top: 0, right: 16, bottom: 0, left: 16 } }
                    variants:
                      - when: { interaction: hovered }
                        props: { background: "#544CE8" }
                      - when: { interaction: pressed }
                        props: { background: "#443DC8" }
                      - when: { interaction: focused }
                        props: { border: { thickness: 2, color: "#A9A4FF" } }
                    children:
                      - type: text
                        props: { text: Export report, size: 13, weight: 600, color: "#FFFFFF", font: assets/StudioSans.ttf }
                        place: { alignment: center }
              - type: grid
                props: { columns: [1fr, 1fr, 1fr], gap: 16, height: 148 }
                responsive:
                  compact: { props: { columns: [1fr], height: 420 } }
                children:
                  - type: instance
                    props: { component: metric, parameters: { label: Net revenue, value: "$84,240", delta: "+12.4% this month" } }
                  - type: instance
                    props: { component: metric, parameters: { label: Active customers, value: "18,429", delta: "+8.1% this month" } }
                  - type: instance
                    props: { component: metric, parameters: { label: Conversion rate, value: "7.8%", delta: "+1.3% this month" } }
              - type: grid
                props: { columns: [2fr, 1fr], gap: 20, height: 340 }
                responsive:
                  compact: { props: { columns: [1fr], height: 650 } }
                children:
                  - type: surface
                    props: { background: "#FFFFFF", padding: { top: 22, right: 22, bottom: 20, left: 22 }, radius: 16, border: { thickness: 1, color: "#E8EBF1" } }
                    children:
                      - type: stack
                        props: { direction: vertical, gap: 16 }
                        children:
                          - type: stack
                            props: { direction: horizontal, height: 40, alignment: center }
                            children:
                              - type: stack
                                props: { direction: vertical, gap: 3 }
                                children:
                                  - type: text
                                    props: { text: Revenue momentum, size: 16, weight: 700, color: "#182230", font: assets/StudioSans.ttf }
                                  - type: text
                                    props: { text: Actual versus target · last 8 months, size: 11, color: "#8A94A6", font: assets/StudioSans.ttf }
                              - type: spacer
                                place: { grow: 1 }
                              - type: text
                                props: { text: "+18.2%", size: 12, weight: 700, color: "#16A36A", font: assets/StudioSans.ttf }
                          - type: surface
                            props: { height: 230, background: { ref: theme.linear_gradient.accent } }
                            children:
                              - type: surface
                                props: { width: 280, height: 86, background: "#151D29E8", padding: { top: 13, right: 15, bottom: 13, left: 15 }, radius: 12 }
                                place: { x: 20, y: 124 }
                                children:
                                  - type: stack
                                    props: { direction: vertical, gap: 5 }
                                    children:
                                      - type: text
                                        props: { text: Revenue momentum, size: 14, weight: 700, color: "#FFFFFF", font: assets/StudioSans.ttf }
                                      - type: text
                                        props: { text: "+18.2% quarter over quarter", size: 11, color: "#CBD2DC", font: assets/StudioSans.ttf }
                  - type: surface
                    props: { background: "#FFFFFF", padding: { top: 12, right: 12, bottom: 12, left: 12 }, radius: 16, border: { thickness: 1, color: "#E8EBF1" } }
                    children:
                      - type: overlay
                        children:
                          - type: image
                            props: { src: assets/dashboard.jpg, fit: cover }
                          - type: surface
                            props: { width: 220, height: 92, background: "#151D29E8", padding: { top: 14, right: 16, bottom: 14, left: 16 }, radius: 12 }
                            place: { x: 16, y: 210 }
                            children:
                              - type: stack
                                props: { direction: vertical, gap: 5 }
                                children:
                                  - type: text
                                    props: { text: Growth campaign, size: 14, weight: 700, color: "#FFFFFF", font: assets/StudioSans.ttf }
                                  - type: text
                                    props: { text: 68% of quarterly target reached, size: 11, color: "#CBD2DC", font: assets/StudioSans.ttf }
              - type: surface
                props: { height: 260, background: "#FFFFFF", padding: { top: 22, right: 24, bottom: 22, left: 24 }, radius: 16, border: { thickness: 1, color: "#E8EBF1" } }
                children:
                  - type: stack
                    props: { direction: vertical, gap: 14 }
                    children:
                      - type: text
                        props: { text: Top customers, size: 16, weight: 700, color: "#182230", font: assets/StudioSans.ttf }
                      - type: divider
                        props: { height: 1, thickness: 1, color: "#EEF0F4" }
                      - type: text
                        props: { text: "Luma Labs                  $18,420       +14.2%\nArc Systems               $12,880         +9.6%\nFieldwork Co.              $9,640         +7.1%\nMonument                  $7,920         +5.4%", size: 12, line_height: 40, color: "#445065", font: assets/StudioSans.ttf }

  revenue:
    type: stack
    name: revenue-shell
    props: { direction: horizontal, gap: 0 }
    children:
      - type: instance
        name: revenue-sidebar
        props: { component: sidebar }
        responsive:
          compact: { visible: false }
      - type: scroll
        name: revenue-feed
        props: { axis: vertical, scrollbar: true }
        place: { basis: 0, grow: 1, shrink: 1 }
        children:
          - type: stack
            props: { direction: vertical, gap: 20, height: 900, padding: { top: 28, right: 28, bottom: 28, left: 28 } }
            children:
              - type: stack
                props: { direction: vertical, gap: 5, height: 66 }
                children:
                  - type: text
                    props: { text: Revenue intelligence, size: 28, weight: 700, color: "#182230", font: assets/StudioSans.ttf }
                  - type: text
                    props: { text: "Track recurring growth, channel mix, and forecast health.", size: 13, color: "#7B8596", font: assets/StudioSans.ttf }
              - type: grid
                props: { columns: [1fr, 1fr, 1fr], gap: 16, height: 148 }
                children:
                  - type: instance
                    props: { component: metric, parameters: { label: Monthly recurring revenue, value: "$312,840", delta: "+11.8% this quarter" } }
                  - type: instance
                    props: { component: metric, parameters: { label: Average contract value, value: "$18,620", delta: "+6.4% this quarter" } }
                  - type: instance
                    props: { component: metric, parameters: { label: Forecast attainment, value: "92.6%", delta: "+4.2 pts this month" } }
              - type: surface
                props: { height: 390, background: "#FFFFFF", padding: { top: 24, right: 24, bottom: 24, left: 24 }, radius: 16, border: { thickness: 1, color: "#E8EBF1" } }
                children:
                  - type: stack
                    props: { direction: vertical, gap: 18 }
                    children:
                      - type: text
                        props: { text: Recurring revenue · last 8 months, size: 16, weight: 700, color: "#182230", font: assets/StudioSans.ttf }
                      - type: surface
                        props: { height: 290, background: { ref: theme.linear_gradient.accent } }
                        children:
                          - type: text
                            props: { text: "$312.8k current", size: 22, weight: 700, color: "#FFFFFF", font: assets/StudioSans.ttf }
                            place: { x: 24, y: 220 }

  customers:
    type: stack
    name: customers-shell
    props: { direction: horizontal, gap: 0 }
    children:
      - type: instance
        name: customers-sidebar
        props: { component: sidebar }
        responsive:
          compact: { visible: false }
      - type: scroll
        name: customers-feed
        props: { axis: vertical, scrollbar: true }
        place: { basis: 0, grow: 1, shrink: 1 }
        children:
          - type: stack
            props: { direction: vertical, gap: 20, height: 900, padding: { top: 28, right: 28, bottom: 28, left: 28 } }
            children:
              - type: stack
                props: { direction: vertical, gap: 5, height: 66 }
                children:
                  - type: text
                    props: { text: Customer portfolio, size: 28, weight: 700, color: "#182230", font: assets/StudioSans.ttf }
                  - type: text
                    props: { text: "Understand account health, expansion, and retention risk.", size: 13, color: "#7B8596", font: assets/StudioSans.ttf }
              - type: grid
                props: { columns: [1fr, 1fr, 1fr], gap: 16, height: 148 }
                children:
                  - type: instance
                    props: { component: metric, parameters: { label: Active accounts, value: "18,429", delta: "+8.1% this month" } }
                  - type: instance
                    props: { component: metric, parameters: { label: Net retention, value: "114.6%", delta: "+3.2 pts this quarter" } }
                  - type: instance
                    props: { component: metric, parameters: { label: At-risk revenue, value: "$28,940", delta: "-12.5% this month" } }
              - type: surface
                props: { height: 430, background: "#FFFFFF", padding: { top: 24, right: 24, bottom: 24, left: 24 }, radius: 16, border: { thickness: 1, color: "#E8EBF1" } }
                children:
                  - type: stack
                    props: { direction: vertical, gap: 15 }
                    children:
                      - type: text
                        props: { text: Priority accounts, size: 16, weight: 700, color: "#182230", font: assets/StudioSans.ttf }
                      - type: divider
                        props: { height: 1, thickness: 1, color: "#EEF0F4" }
                      - type: text
                        props: { text: "Luma Labs                Enterprise        $18,420           96 Excellent\nArc Systems             Enterprise        $12,880           91 Excellent\nFieldwork Co.            Mid-market         $9,640           84 Healthy\nMonument                 Mid-market         $7,920           72 Watch\nNorthwind                Enterprise         $6,480           64 At risk", size: 12, line_height: 52, color: "#445065", font: assets/StudioSans.ttf }

  reports:
    type: stack
    name: reports-shell
    props: { direction: horizontal, gap: 0 }
    children:
      - type: instance
        name: reports-sidebar
        props: { component: sidebar }
        responsive:
          compact: { visible: false }
      - type: scroll
        name: reports-feed
        props: { axis: vertical, scrollbar: true }
        place: { basis: 0, grow: 1, shrink: 1 }
        children:
          - type: stack
            props: { direction: vertical, gap: 20, height: 900, padding: { top: 28, right: 28, bottom: 28, left: 28 } }
            children:
              - type: stack
                props: { direction: vertical, gap: 5, height: 66 }
                children:
                  - type: text
                    props: { text: Reports library, size: 28, weight: 700, color: "#182230", font: assets/StudioSans.ttf }
                  - type: text
                    props: { text: Review scheduled packs and reusable performance views., size: 13, color: "#7B8596", font: assets/StudioSans.ttf }
              - type: grid
                props: { columns: [1fr, 1fr], gap: 18, height: 440 }
                children:
                  - type: surface
                    props: { background: "#FFFFFF", padding: { top: 24, right: 24, bottom: 24, left: 24 }, radius: 16, border: { thickness: 1, color: "#E8EBF1" } }
                    children:
                      - type: stack
                        props: { direction: vertical, gap: 12 }
                        children:
                          - type: text
                            props: { text: Executive performance, size: 16, weight: 700, color: "#182230", font: assets/StudioSans.ttf }
                          - type: text
                            props: { text: "Revenue, pipeline, retention, and forecast summary.", size: 12, color: "#7B8596", font: assets/StudioSans.ttf }
                          - type: spacer
                            place: { grow: 1 }
                          - type: text
                            props: { text: Updated today · Monthly, size: 11, weight: 600, color: "#635BFF", font: assets/StudioSans.ttf }
                  - type: surface
                    props: { background: "#FFFFFF", padding: { top: 24, right: 24, bottom: 24, left: 24 }, radius: 16, border: { thickness: 1, color: "#E8EBF1" } }
                    children:
                      - type: stack
                        props: { direction: vertical, gap: 12 }
                        children:
                          - type: text
                            props: { text: Customer health, size: 16, weight: 700, color: "#182230", font: assets/StudioSans.ttf }
                          - type: text
                            props: { text: "Cohort retention, expansion signals, and renewal risk.", size: 12, color: "#7B8596", font: assets/StudioSans.ttf }
                          - type: spacer
                            place: { grow: 1 }
                          - type: text
                            props: { text: Updated yesterday · Weekly, size: 11, weight: 600, color: "#635BFF", font: assets/StudioSans.ttf }
                  - type: surface
                    props: { background: "#FFFFFF", padding: { top: 24, right: 24, bottom: 24, left: 24 }, radius: 16, border: { thickness: 1, color: "#E8EBF1" } }
                    children:
                      - type: text
                        props: { text: "Channel efficiency\n\nAcquisition cost, conversion, and revenue by source.\n\nUpdated 3 days ago · Monthly", size: 14, line_height: 30, color: "#445065", font: assets/StudioSans.ttf }
                  - type: surface
                    props: { background: "#172033", padding: { top: 24, right: 24, bottom: 24, left: 24 }, radius: 16 }
                    children:
                      - type: text
                        props: { text: Board pack\n\nQuarterly narrative with financial and customer context.\n\nDue in 6 days · Quarterly, size: 14, line_height: 30, color: "#FFFFFF", font: assets/StudioSans.ttf }
