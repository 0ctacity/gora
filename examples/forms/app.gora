gora: 1
kind: app
name: Forms
imports:
  components:
    contact: contact.gora
viewport:
  width: 960
  height: 760
  background: "#F4F1EA"
breakpoints:
  compact: { max_width: 639 }
  wide: { min_width: 640 }
state:
  name: { type: text, default: Ada Lovelace }
  email: { type: text, default: ada@example.com }
  seats: { type: number, default: 3, min: 1, max: 21, step: 2 }
  biography: { type: text, default: "Mathematician and writer." }
  status: { type: text, default: Ready to edit }
  account_id: { type: text, default: NS-1842 }
  archived_note: { type: text, default: Archived profiles cannot edit this field. }
entry: profile
screens:
  profile:
    type: scroll
    name: form-page
    props: { axis: vertical, scrollbar: true }
    children:
      - type: surface
        props:
          padding: { top: 56, right: 56, bottom: 72, left: 56 }
        responsive:
          compact:
            props:
              padding: { top: 28, right: 20, bottom: 48, left: 20 }
        children:
          - type: form
            name: profile-form
            on:
              submit:
                - { action: set, state: status, value: Profile saved }
            children:
              - type: stack
                props: { direction: vertical, gap: 28, max_width: 720 }
                children:
                  - type: stack
                    props: { direction: vertical, gap: 8 }
                    children:
                      - type: text
                        props: { text: Profile details, size: 34, weight: 700, color: "#18211C" }
                      - type: text
                        props: { text: Valid drafts update local state immediately; submit runs the form actions., size: 16, color: "#657068" }
                  - type: text_field
                    name: name-field
                    props:
                      label: Full name
                      bind: name
                      required: true
                      min_length: 2
                      max_length: 80
                      placeholder: Your full name
                      gap: 7
                    variants:
                      - when: { interaction: invalid }
                        props: { opacity: 0.92 }
                    children:
                      - type: field_box
                        props:
                          height: 52
                          padding: { top: 14, right: 16, bottom: 14, left: 16 }
                          background: "#FFFFFF"
                          border: { thickness: 1, color: "#C9D0CA" }
                          radius: 12
                          size: 16
                          color: "#18211C"
                          placeholder_color: "#919A93"
                          selection_color: "#C9DDD0"
                          caret_color: "#28734D"
                      - type: field_support
                        children:
                          - type: text
                            props: { text: Use at least two characters., size: 13, color: "#657068" }
                  - type: text_field
                    name: email-field
                    props:
                      label: Email
                      bind: email
                      required: true
                      pattern: '[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+'
                      placeholder: name@example.com
                    children:
                      - type: field_box
                        props:
                          height: 52
                          padding: { top: 14, right: 16, bottom: 14, left: 16 }
                          background: "#FFFFFF"
                          border: { thickness: 1, color: "#C9D0CA" }
                          radius: 12
                          size: 16
                          color: "#18211C"
                          placeholder_color: "#919A93"
                          selection_color: "#C9DDD0"
                          caret_color: "#28734D"
                        variants:
                          - when: { interaction: invalid }
                            props:
                              background: "#FFF7F7"
                              border: { thickness: 1, color: "#C93756" }
                      - type: field_support
                        variants:
                          - when: { interaction: valid }
                            visible: false
                          - when: { interaction: invalid }
                            visible: true
                        children:
                          - type: text
                            props: { text: Enter a complete email address., size: 13, color: "#C93756" }
                  - type: text_field
                    name: seats-field
                    props: { label: Seats, bind: seats, placeholder: "3" }
                    children:
                      - type: field_box
                        props:
                          width: 180
                          height: 52
                          padding: { top: 14, right: 16, bottom: 14, left: 16 }
                          background: "#FFFFFF"
                          border: { thickness: 1, color: "#C9D0CA" }
                          radius: 12
                          size: 16
                          color: "#18211C"
                          selection_color: "#C9DDD0"
                          caret_color: "#28734D"
                  - type: text_field
                    name: account-id-field
                    props: { label: Account ID, bind: account_id, read_only: true }
                    children:
                      - type: field_box
                        props:
                          height: 52
                          padding: { top: 14, right: 16, bottom: 14, left: 16 }
                          background: "#E9ECE8"
                          border: { thickness: 1, color: "#D2D7D2" }
                          radius: 12
                          size: 16
                          color: "#657068"
                  - type: text_field
                    name: archived-note-field
                    props: { label: Archived note, bind: archived_note, disabled: true }
                    children:
                      - type: field_box
                        props:
                          height: 52
                          padding: { top: 14, right: 16, bottom: 14, left: 16 }
                          background: "#ECEDEB"
                          border: { thickness: 1, color: "#D8DBD7" }
                          radius: 12
                          size: 16
                          color: "#9AA19B"
                  - type: text_area
                    name: biography-field
                    props:
                      label: Biography
                      bind: biography
                      min_lines: 4
                      max_lines: 8
                      max_length: 400
                      placeholder: Tell us about your work
                    children:
                      - type: field_box
                        props:
                          height: 132
                          padding: { top: 14, right: 16, bottom: 14, left: 16 }
                          background: "#FFFFFF"
                          border: { thickness: 1, color: "#C9D0CA" }
                          radius: 12
                          size: 16
                          color: "#18211C"
                          placeholder_color: "#919A93"
                          selection_color: "#C9DDD0"
                          caret_color: "#28734D"
                  - type: instance
                    name: secondary-contact
                    props: { component: contact }
                  - type: stack
                    props: { direction: horizontal, gap: 12, alignment: center, wrap: true }
                    children:
                      - type: button
                        name: save-profile
                        props:
                          label: Save profile
                          form_action: submit
                          padding: { top: 12, right: 20, bottom: 12, left: 20 }
                          background: "#28734D"
                          radius: 11
                        variants:
                          - when: { interaction: hovered }
                            props: { background: "#205F40" }
                          - when: { interaction: focused }
                            props: { border: { thickness: 2, color: "#93C5A8" } }
                        children:
                          - type: text
                            props: { text: Save profile, color: "#FFFFFF", weight: 600 }
                      - type: button
                        name: reset-profile
                        props:
                          label: Reset
                          form_action: reset
                          padding: { top: 12, right: 20, bottom: 12, left: 20 }
                          background: "#E4E8E4"
                          radius: 11
                        children:
                          - type: text
                            props: { text: Reset, color: "#263029", weight: 600 }
                      - type: text
                        props: { text: { ref: state.status }, color: "#657068", size: 14 }
